NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://postgres:replace-this@localhost:5432/dipvtc
DATABASE_SSL=false
ALLOWED_ORIGIN=
TRUST_PROXY=false
INITIAL_OWNER_EMAIL=owner@example.com
INITIAL_OWNER_NAME=DIPVTC Owner
INITIAL_OWNER_PASSWORD=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=School Administrator
INITIAL_ADMIN_SECTION=All Sections
INITIAL_ADMIN_PASSWORD=

# Encrypt Owner authenticator secrets at rest. Generate once with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep the same value in local and Render environments; changing it disables access to stored authenticator secrets.
OWNER_2FA_ENCRYPTION_KEY=

# Email transport: use resend over HTTPS on Render Free, or smtp locally / on a paid service.
EMAIL_TRANSPORT=smtp
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Double Impact Private College

# Outgoing school email (obtain these values from your hosting email settings)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Double Impact Private College

# Set to the public website address when deploying online.
PUBLIC_BASE_URL=
SCHOOL_TIMEZONE=Africa/Harare

# Private S3-compatible learning media storage (for example an S3/R2 bucket).
# Keep the bucket private. Configure these in Render Environment Variables, not git.
MEDIA_STORAGE_DRIVER=s3
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=auto
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_MAX_UPLOAD_MB=25

# Meta WhatsApp Cloud API. Set secrets in Render Environment, never commit them.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v27.0
